{
  "info": {
    "name": "new-one-two — Local Testing",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Follows INSTRUCTIONS.md phases A, B, and C. Set collection variables before running."
  },
  "variable": [
    { "key": "baseUrl",            "value": "http://localhost:3002",              "type": "string" },
    { "key": "generatorUrl",       "value": "http://localhost:8001",              "type": "string" },
    { "key": "gatewayUrl",         "value": "http://localhost:3001",              "type": "string" },
    { "key": "tenantId",           "value": "00000000-0000-0000-0000-000000000001", "type": "string" },
    { "key": "appId",              "value": "00000000-0000-0000-0000-000000000002", "type": "string" },
    { "key": "jobId",              "value": "",                                   "type": "string",  "description": "Auto-populated by 'Start Generation' requests" },
    { "key": "shopDomain",         "value": "your-store.myshopify.com",           "type": "string" },
    { "key": "shopifyAccessToken", "value": "shpua_...",                          "type": "string" },
    { "key": "ngrokUrl",           "value": "https://abc123.ngrok.io",            "type": "string" }
  ],
  "item": [
    {
      "name": "Phase A — Smoke Test (no credentials)",
      "item": [
        {
          "name": "Health — API",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health",
            "description": "Check #4: API service is up and returns { service: 'api' }"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('service: api', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.service).to.eql('api');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Health — Generator (Python)",
          "request": {
            "method": "GET",
            "url": "{{generatorUrl}}/health",
            "description": "Verify the FastAPI generator service is reachable"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Start Generation — storefront_ui (smoke)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/generation",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appId\":        \"{{appId}}\",\n  \"tenantId\":     \"{{tenantId}}\",\n  \"prompt\":       \"Build me a notify me when back in stock feature\",\n  \"appArchetype\": \"storefront_ui\",\n  \"platformApiCatalog\": [\n    { \"method\": \"POST\", \"path\": \"/features/waitlist/signup\" },\n    { \"method\": \"GET\",  \"path\": \"/features/waitlist/status\" }\n  ]\n}"
            },
            "description": "Check #5: POST /generation returns { jobId, sessionId } with HTTP 202. Also publishes GenerationRequest to generator-sub (check #6)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 202', () => pm.response.to.have.status(202));",
                  "pm.test('has jobId and sessionId', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.jobId).to.be.a('string');",
                  "  pm.expect(body.sessionId).to.be.a('string');",
                  "  pm.collectionVariables.set('jobId', body.jobId);",
                  "  console.log('jobId saved:', body.jobId);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Result — by jobId",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/generation/{{jobId}}/result",
            "description": "Check #9: Returns the full bundle after the mock FeatureBundleMessage is injected (smoke: wait ~5s after injection). jobId is auto-populated from 'Start Generation'."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('has bundle', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('bundle');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Result — unknown jobId (expect 404)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/generation/00000000-0000-0000-0000-000000000000/result",
            "description": "Check #10: Unknown jobId must return 404."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Phase B — Real AI Generation (Anthropic key required)",
      "item": [
        {
          "name": "Create Tenant",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/tenants",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\":           \"{{tenantId}}\",\n  \"slug\":         \"dev-tenant\",\n  \"name\":         \"Dev Tenant\",\n  \"appArchetype\": \"storefront_ui\"\n}"
            },
            "description": "Creates the tenant row. Pass a fixed id to match the collection variable (idempotent-friendly for reruns). Run this before Create App and POST /generation."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('returned id matches tenantId variable', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.id).to.eql(pm.collectionVariables.get('tenantId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create App",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/tenants/{{tenantId}}/apps",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\":         \"{{appId}}\",\n  \"slug\":       \"dev-app\",\n  \"name\":       \"Dev App\",\n  \"shopDomain\": \"dev-store.myshopify.com\"\n}"
            },
            "description": "Creates the app row under the tenant. Pass a fixed id to match the collection variable. Run this after Create Tenant and before POST /generation."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('returned id matches appId variable', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.id).to.eql(pm.collectionVariables.get('appId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Start Generation — storefront_ui (back-in-stock)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/generation",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appId\":        \"{{appId}}\",\n  \"tenantId\":     \"{{tenantId}}\",\n  \"prompt\":       \"Build me a notify me when back in stock feature\",\n  \"appArchetype\": \"storefront_ui\",\n  \"platformApiCatalog\": [\n    { \"method\": \"POST\", \"path\": \"/features/waitlist/signup\" },\n    { \"method\": \"GET\",  \"path\": \"/features/waitlist/status\" }\n  ]\n}"
            },
            "description": "Kicks off the five-agent Python pipeline. Watch generator-python logs: intent → schema → codegen (parallel) → validation → explanation."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 202', () => pm.response.to.have.status(202));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('jobId', body.jobId);",
                  "console.log('jobId saved:', body.jobId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Start Generation — backend_only",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/generation",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appId\":        \"{{appId}}\",\n  \"tenantId\":     \"{{tenantId}}\",\n  \"prompt\":       \"Add an automated restock alert email to the store owner\",\n  \"appArchetype\": \"backend_only\",\n  \"platformApiCatalog\": [\n    { \"method\": \"POST\", \"path\": \"/features/alerts/restock\" }\n  ]\n}"
            },
            "description": "backend_only archetype — result must have widgetConfig: null."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 202', () => pm.response.to.have.status(202));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('jobId', body.jobId);",
                  "console.log('jobId saved:', body.jobId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Watch Progress (SSE)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/generation/{{jobId}}/progress",
            "description": "Server-Sent Events stream. Keep open in a terminal with: curl -N http://localhost:3002/generation/<jobId>/progress. Postman will display the SSE frames as they arrive."
          }
        },
        {
          "name": "Fetch Result",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/generation/{{jobId}}/result",
            "description": "Poll after progress stream closes. Verify: widgetConfig non-null for storefront_ui, null for backend_only; handlerModule uses ctx.shopify / ctx.db; dbMigration.sql has tenant_id UUID NOT NULL and CREATE POLICY (or empty string)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('bundle has required fields', () => {",
                  "  const { bundle } = pm.response.json();",
                  "  pm.expect(bundle).to.have.all.keys('widgetConfig', 'handlerModule', 'dbMigration', 'explanation');",
                  "});",
                  "pm.test('handlerModule uses ctx (no raw fetch/require)', () => {",
                  "  const code = pm.response.json().bundle?.handlerModule?.code ?? '';",
                  "  pm.expect(code).to.include('ctx.');",
                  "  pm.expect(code).not.to.include('require(');",
                  "  pm.expect(code).not.to.match(/fetch\\s*\\(/);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Approve + Deploy",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/generation/{{jobId}}/approve",
            "description": "Runs DB migration, stores widget_config, deploys handler. Shopify App Block is stubbed at this phase."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('approved', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Phase C — Full Shopify Loop",
      "item": [
        {
          "name": "Start Generation — back-in-stock (Shopify)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/generation",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appId\":        \"{{appId}}\",\n  \"tenantId\":     \"{{tenantId}}\",\n  \"prompt\":       \"Back in stock notifier\",\n  \"appArchetype\": \"storefront_ui\",\n  \"platformApiCatalog\": [\n    { \"method\": \"POST\", \"path\": \"/features/waitlist/signup\" },\n    { \"method\": \"GET\",  \"path\": \"/features/waitlist/status\" }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 202', () => pm.response.to.have.status(202));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('jobId', body.jobId);",
                  "console.log('jobId saved:', body.jobId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Watch Progress (SSE)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/generation/{{jobId}}/progress"
          }
        },
        {
          "name": "Approve + Deploy (Shopify)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/generation/{{jobId}}/approve",
            "description": "Runs DB migration, stores widget_config for tenant, deploys handler to local Docker, auto-registers webhooks."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('approved', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Widget Config",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{gatewayUrl}}/widget-config?shop={{shopDomain}}",
              "host": ["{{gatewayUrl}}"],
              "path": ["widget-config"],
              "query": [{ "key": "shop", "value": "{{shopDomain}}" }]
            },
            "description": "Verify widget_config was stored for this tenant's shop domain after approve. Must return widgetConfig JSON with widget_type, ui, and actions fields."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('widgetConfig has required fields', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.all.keys('widget_type', 'ui', 'actions');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Register Shopify Webhook — inventory_levels/update",
          "request": {
            "method": "POST",
            "url": "https://{{shopDomain}}/admin/api/2024-01/webhooks.json",
            "header": [
              { "key": "X-Shopify-Access-Token", "value": "{{shopifyAccessToken}}" },
              { "key": "Content-Type",            "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"webhook\": {\n    \"topic\":   \"inventory_levels/update\",\n    \"address\": \"{{ngrokUrl}}/webhooks/inventory_levels/update\",\n    \"format\":  \"json\"\n  }\n}"
            },
            "description": "Manual webhook registration — only needed for testing gateway routing before a full deployment. Set shopifyAccessToken and ngrokUrl collection variables first."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('webhook created', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Generator — Direct (bypass Pub/Sub)",
      "item": [
        {
          "name": "Health — Generator (Python)",
          "request": {
            "method": "GET",
            "url": "{{generatorUrl}}/health"
          }
        },
        {
          "name": "Trigger Generation — /trigger (dev endpoint)",
          "request": {
            "method": "POST",
            "url": "{{generatorUrl}}/trigger",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jobId\":        \"00000000-0000-0000-0000-000000000099\",\n  \"tenantId\":     \"{{tenantId}}\",\n  \"appId\":        \"{{appId}}\",\n  \"prompt\":       \"Build me a notify me when back in stock feature\",\n  \"appArchetype\": \"storefront_ui\",\n  \"platformApiCatalog\": [\n    { \"method\": \"POST\", \"path\": \"/features/waitlist/signup\" },\n    { \"method\": \"GET\",  \"path\": \"/features/waitlist/status\" }\n  ]\n}"
            },
            "description": "Bypasses Pub/Sub entirely — enqueues run_feature_generation as a FastAPI BackgroundTask. Useful for testing the Python pipeline directly without a running API service."
          }
        }
      ]
    }
  ]
}
