      "webhookContract": null,
      "cronContract": {
        "schedule": "0 2 * * *",
        "description": "Nightly job that scans all product images across the store, identifies images larger than 400x400, resizes them using sharp, re-uploads via Shopify Admin REST, and deletes originals. Skips images already at or below 400x400.",
        "handlerMustProduce": "For each tenant with auto_run_enabled=true: a complete list of all product IDs and their associated image records (image ID, src URL, width, height) fetched in bulk via paginated Shopify Admin REST before the processing loop begins. Each image binary is then fetched via outbound HTTPS, resized to max 400x400 preserving aspect ratio using sharp, and the resulting buffer size captured. A new image_optimization_jobs record is created at job start and updated with final counts on completion."
      },
