    "appContracts": {
      "feasibility": "feasible",
      "blockedReason": null,
      "complexity": "high",
      "stateMachine": null,
      "platformGaps": [
        {
          "gap": "Shopify does not allow direct replacement of existing product images via binary upload in a single step; images must be re-uploaded and the old image deleted.",
          "mitigation": "Handler fetches the original image URL from Shopify Admin REST (GET /admin/api/products/{id}/images.json), downloads the binary via outbound HTTPS, resizes with sharp to max 400x400 (preserving aspect ratio), uploads the new file via POST /admin/api/products/{id}/images.json with base64 attachment, then deletes the original image via DELETE. The widget and admin UI show a pending/completed status from the DB; no real-time confirmation is available since processing is async."
        }
      ],
      "cronBatching": {
        "description": "Each cron run fetches all products (paginated) via Shopify Admin REST in bulk before iterating, to avoid per-product API calls inside the loop. Images are downloaded, resized, and re-uploaded per image within the batch. Rate-limit backoff is applied between uploads."
      },
