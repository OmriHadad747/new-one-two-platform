{
  "prompt": "Whenever someone buys from my store I want to send them a follow up a few days later. Just something personal, like checking in and maybe asking them to leave a review. I don't want to bother people who already replied or came back.",
  "intent": {
    "triggerTypes": [
      "webhook",
      "cron",
      "admin"
    ],
    "resources": [
      "orders",
      "customers"
    ],
    "desiredOutcome": "Send a personalized follow-up email to customers a few days after purchase, skipping those who have already engaged or made a repeat purchase.",
    "cronSchedule": "0 9 * * *",
    "appCategory": "backend_admin"
  },
  "plan": {
    "shopifyPlan": {
      "webhookTopics": [
        "orders/paid"
      ],
      "cronSchedule": "0 9 * * *"
    },
    "appContracts": {
      "feasibility": "feasible",
      "blockedReason": null,
      "complexity": "high",
      "stateMachine": null,
      "platformGaps": [],
      "cronBatching": {
        "description": "The daily cron fetches all follow_up_queue rows where scheduled_send_date <= today AND status = 'pending'. Before looping, it bulk-fetches orders placed since the earliest order_created_at in the batch (to detect repeat purchases) and customer email addresses from Shopify Admin API in a single paginated pass, keyed by customer_id. This avoids N+1 API calls per queue item."
      },
      "dbContracts": [
        {
          "table": "follow_up_queue",
          "columns": [
            {
              "name": "id",
              "type": "UUID",
              "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"
            },
            {
              "name": "tenant_id",
              "type": "UUID",
              "constraints": "NOT NULL"
            },
            {
              "name": "order_id",
              "type": "BIGINT",
              "constraints": "NOT NULL"
            },
            {
              "name": "customer_id",
              "type": "BIGINT",
              "constraints": "NULL"
            },
            {
              "name": "customer_email",
              "type": "TEXT",
              "constraints": "NOT NULL"
            },
            {
              "name": "customer_name",
              "type": "TEXT",
              "constraints": "NULL"
            },
            {
              "name": "order_name",
              "type": "TEXT",
              "constraints": "NOT NULL"
            },
            {
              "name": "scheduled_send_date",
              "type": "DATE",
              "constraints": "NOT NULL"
            },
            {
              "name": "status",
              "type": "TEXT",
              "constraints": "NOT NULL DEFAULT 'pending'"
            },
            {
              "name": "skip_reason",
              "type": "TEXT",
              "constraints": "NULL"
            },
            {
              "name": "sent_at",
              "type": "TIMESTAMPTZ",
              "constraints": "NULL"
            },
            {
              "name": "created_at",
              "type": "TIMESTAMPTZ",
              "constraints": "NOT NULL DEFAULT now()"
            }
          ],
          "uniqueConstraint": [
            "tenant_id",
            "order_id"
          ],
          "indexes": [
            "tenant_id",
            "status",
            "scheduled_send_date",
            "customer_id"
          ],
          "rls": true
        },
        {
          "table": "follow_up_settings",
          "columns": [
            {
              "name": "id",
              "type": "UUID",
              "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"
            },
            {
              "name": "tenant_id",
              "type": "UUID",
              "constraints": "NOT NULL"
            },
            {
              "name": "delay_days",
              "type": "INTEGER",
              "constraints": "NOT NULL DEFAULT 4"
            },
            {
              "name": "email_subject",
              "type": "TEXT",
              "constraints": "NOT NULL DEFAULT 'How did your order go?'"
            },
            {
              "name": "email_body",
              "type": "TEXT",
              "constraints": "NOT NULL DEFAULT 'Hi {{customer_name}}, just checking in on your order {{order_name}}. We would love to hear from you!'"
            },
            {
              "name": "review_url",
              "type": "TEXT",
              "constraints": "NULL"
            },
            {
              "name": "created_at",
              "type": "TIMESTAMPTZ",
              "constraints": "NOT NULL DEFAULT now()"
            },
            {
              "name": "updated_at",
              "type": "TIMESTAMPTZ",
              "constraints": "NOT NULL DEFAULT now()"
            }
          ],
          "uniqueConstraint": [
            "tenant_id"
          ],
          "indexes": [
            "tenant_id"
          ],
          "rls": true
        },
        {
          "table": "follow_up_engagement",
          "columns": [
            {
              "name": "id",
              "type": "UUID",
              "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"
            },
            {
              "name": "tenant_id",
              "type": "UUID",
              "constraints": "NOT NULL"
            },
            {
              "name": "customer_id",
              "type": "BIGINT",
              "constraints": "NULL"
            },
            {
              "name": "customer_email",
              "type": "TEXT",
              "constraints": "NOT NULL"
            },
            {
              "name": "engaged_at",
              "type": "TIMESTAMPTZ",
              "constraints": "NOT NULL DEFAULT now()"
            },
            {
              "name": "engagement_type",
              "type": "TEXT",
              "constraints": "NOT NULL"
            },
            {
              "name": "created_at",
              "type": "TIMESTAMPTZ",
              "constraints": "NOT NULL DEFAULT now()"
            }
          ],
          "uniqueConstraint": [
            "tenant_id",
            "customer_email",
            "engagement_type"
          ],
          "indexes": [
            "tenant_id",
            "customer_email",
            "customer_id"
          ],
          "rls": true
        }
      ],
      "webhookContract": {
        "topic": "orders/paid",
        "payloadFields": [
          "id",
          "name",
          "email",
          "customer",
          "created_at"
        ],
        "handlerMustProduce": "The resolved customer first name (from customer.first_name or the email prefix as fallback), the customer_id (from customer.id, nullable), the order's human-readable name (order.name), and the scheduled_send_date calculated as order.created_at date plus the tenant's configured delay_days from follow_up_settings (defaulting to 4 days). The handler must upsert a single row into follow_up_queue with status='pending', skipping insertion only if a row for this order_id already exists."
      },
      "cronContract": {
        "schedule": "0 9 * * *",
        "handlerMustProduce": "For each pending row in follow_up_queue where scheduled_send_date <= today: (1) the set of customer_ids who have placed any additional order since their original order_created_at, resolved by bulk-fetching recent orders from Shopify Admin API \u2014 rows matching these customer_ids are marked status='skipped', skip_reason='repeat_purchase'; (2) the set of customer_emails present in follow_up_engagement with engagement_type='replied' \u2014 rows matching these emails are marked status='skipped', skip_reason='already_engaged'; (3) for all remaining eligible rows, the rendered email subject and body with {{customer_name}} and {{order_name}} tokens replaced using the tenant's follow_up_settings template, then the email is dispatched and the row updated to status='sent' with sent_at=now()."
      },
      "widgetTargetTemplates": null,
      "widgetApiCatalog": null,
      "adminApiCatalog": [
        {
          "path": "/settings",
          "method": "GET",
          "requestShape": {},
          "responseShape": {
            "delay_days": "number",
            "email_subject": "string",
            "email_body": "string",
            "review_url": "string | null"
          }
        },
        {
          "path": "/settings",
          "method": "POST",
          "requestShape": {
            "delay_days": "number",
            "email_subject": "string",
            "email_body": "string",
            "review_url": "string | null"
          },
          "responseShape": {
            "success": "boolean"
          }
        },
        {
          "path": "/queue",
          "method": "GET",
          "requestShape": {
            "status": "string | null",
            "page": "number",
            "page_size": "number"
          },
          "responseShape": {
            "items": [
              {
                "id": "string",
                "order_id": "number",
                "order_name": "string",
                "customer_email": "string",
                "customer_name": "string | null",
                "scheduled_send_date": "string",
                "status": "string",
                "skip_reason": "string | null",
                "sent_at": "string | null",
                "created_at": "string"
              }
            ],
            "total": "number",
            "page": "number",
            "page_size": "number"
          }
        },
        {
          "path": "/queue/:id/skip",
          "method": "POST",
          "requestShape": {
            "skip_reason": "string"
          },
          "responseShape": {
            "success": "boolean"
          }
        },
        {
          "path": "/engagement",
          "method": "POST",
          "requestShape": {
            "customer_email": "string",
            "customer_id": "number | null",
            "engagement_type": "string"
          },
          "responseShape": {
            "success": "boolean"
          }
        },
        {
          "path": "/run",
          "method": "POST",
          "requestShape": {},
          "responseShape": {
            "sent_count": "number",
            "skipped_count": "number",
            "errors": [
              "string"
            ]
          }
        },
        {
          "path": "/stats",
          "method": "GET",
          "requestShape": {},
          "responseShape": {
            "total_pending": "number",
            "total_sent": "number",
            "total_skipped": "number"
          }
        }
      ]
    }
  },
  "validation_errors": []
}