      "platformGaps": [
        {
          "gap": "Shopify does not expose raw image pixel dimensions in the Admin API product image payload \u2014 width and height must be inferred.",
          "mitigation": "Fetch each image via outbound HTTPS, then use sharp to decode the image buffer and read its width/height metadata before deciding whether optimization is needed."
        },
        {
          "gap": "Shopify does not provide a batch endpoint to fetch all product images across all products in one call.",
          "mitigation": "Use Shopify Admin REST API with paginated GET /products.json (with images included) to bulk-fetch all products and their image URLs before the per-image processing loop."
        },
        {
          "gap": "No batch write API for uploading optimized product images \u2014 each image requires an individual Shopify API call or managed file upload.",
          "mitigation": "Pre-fetch all required read data before the loop; per-item write calls inside the loop are unavoidable. Optimized image files are stored via ctx.services.files and the public URL is recorded in the DB for admin comparison display."
        },
        {
          "gap": "Long-running scan-and-optimize job cannot be executed synchronously within a single HTTP request cycle for large catalogs.",
          "mitigation": "Use a DB status column (pending/running/completed/failed) updated in-place. The admin triggers the job via POST /scan/start, the handler processes synchronously in the request, and the admin polls GET /scan/status to reflect current progress and results."
        }
      ],
