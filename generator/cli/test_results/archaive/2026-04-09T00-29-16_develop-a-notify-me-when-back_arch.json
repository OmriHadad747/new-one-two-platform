{
	"prompt": "Develop a Notify Me When Back In Stock Shopify app with admin interface for managing subscriptions and notifications.",
	"intent": {
		"triggerTypes": [
			"webhook",
			"cron",
			"admin",
			"widget"
		],
		"resources": [
			"products",
			"inventory",
			"customers"
		],
		"desiredOutcome": "Customers subscribe to back-in-stock alerts for sold-out products, and merchants manually or automatically notify them when inventory is replenished.",
		"cronSchedule": "0 */6 * * *",
		"appCategory": "storefront_backend_admin"
	},
	"plan": {
		"shopifyPlan": {
			"webhookTopics": [
				"inventory_levels/update"
			],
			"cronSchedule": "0 */6 * * *"
		},
		"appContracts": {
			"feasibility": "feasible",
			"blockedReason": null,
			"complexity": "high",
			"stateMachine": {
				"entity": "inventory_level",
				"trackedField": "available",
				"unknownSentinel": "null",
				"skipWhenUnknown": false,
				"transitions": [
					{
						"from": "zero_or_negative",
						"to": "positive",
						"action": "trigger_back_in_stock_notifications"
					},
					{
						"from": "positive",
						"to": "zero_or_negative",
						"action": "mark_variant_out_of_stock"
					}
				]
			},
			"platformGaps": [
				{
					"gap": "No real-time push notification to storefront after subscription is recorded",
					"mitigation": "Widget shows a static confirmation message immediately after POST /subscribe returns success. No live delivery confirmation is needed \u2014 the email will arrive asynchronously via the email capability."
				}
			],
			"cronBatching": {
				"description": "Every 6 hours, fetch all distinct inventory_item_id + location_id pairs for variants that have active subscriptions. Bulk-fetch current inventory levels from Shopify Admin API in a single paginated query before iterating, then compare against last_known_quantity stored in the inventory_snapshots table to detect restocks without per-item API calls inside the loop."
			},
			"dbContracts": [
				{
					"table": "back_in_stock_subscriptions",
					"columns": [
						{
							"name": "id",
							"type": "UUID",
							"constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"
						},
						{
							"name": "tenant_id",
							"type": "UUID",
							"constraints": "NOT NULL"
						},
						{
							"name": "customer_id",
							"type": "BIGINT",
							"constraints": "NULL"
						},
						{
							"name": "email",
							"type": "TEXT",
							"constraints": "NOT NULL"
						},
						{
							"name": "product_id",
							"type": "BIGINT",
							"constraints": "NOT NULL"
						},
						{
							"name": "variant_id",
							"type": "BIGINT",
							"constraints": "NOT NULL"
						},
						{
							"name": "product_title",
							"type": "TEXT",
							"constraints": "NOT NULL"
						},
						{
							"name": "variant_title",
							"type": "TEXT",
							"constraints": "NULL"
						},
						{
							"name": "product_image_url",
							"type": "TEXT",
							"constraints": "NULL"
						},
						{
							"name": "status",
							"type": "TEXT",
							"constraints": "NOT NULL DEFAULT 'active'"
						},
						{
							"name": "notified_at",
							"type": "TIMESTAMPTZ",
							"constraints": "NULL"
						},
						{
							"name": "created_at",
							"type": "TIMESTAMPTZ",
							"constraints": "NOT NULL DEFAULT now()"
						}
					],
					"uniqueConstraint": [
						"tenant_id",
						"email",
						"variant_id"
					],
					"indexes": [
						"tenant_id",
						"variant_id",
						"status",
						"product_id"
					],
					"rls": true
				},
				{
					"table": "inventory_snapshots",
					"columns": [
						{
							"name": "id",
							"type": "UUID",
							"constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"
						},
						{
							"name": "tenant_id",
							"type": "UUID",
							"constraints": "NOT NULL"
						},
						{
							"name": "inventory_item_id",
							"type": "BIGINT",
							"constraints": "NOT NULL"
						},
						{
							"name": "location_id",
							"type": "BIGINT",
							"constraints": "NOT NULL"
						},
						{
							"name": "variant_id",
							"type": "BIGINT",
							"constraints": "NOT NULL"
						},
						{
							"name": "last_known_quantity",
							"type": "INTEGER",
							"constraints": "NULL"
						},
						{
							"name": "updated_at",
							"type": "TIMESTAMPTZ",
							"constraints": "NOT NULL DEFAULT now()"
						},
						{
							"name": "created_at",
							"type": "TIMESTAMPTZ",
							"constraints": "NOT NULL DEFAULT now()"
						}
					],
					"uniqueConstraint": [
						"tenant_id",
						"inventory_item_id",
						"location_id"
					],
					"indexes": [
						"tenant_id",
						"variant_id",
						"inventory_item_id"
					],
					"rls": true
				},
				{
					"table": "notification_logs",
					"columns": [
						{
							"name": "id",
							"type": "UUID",
							"constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"
						},
						{
							"name": "tenant_id",
							"type": "UUID",
							"constraints": "NOT NULL"
						},
						{
							"name": "subscription_id",
							"type": "UUID",
							"constraints": "NOT NULL"
						},
						{
							"name": "variant_id",
							"type": "BIGINT",
							"constraints": "NOT NULL"
						},
						{
							"name": "email",
							"type": "TEXT",
							"constraints": "NOT NULL"
						},
						{
							"name": "trigger_source",
							"type": "TEXT",
							"constraints": "NOT NULL"
						},
						{
							"name": "sent_at",
							"type": "TIMESTAMPTZ",
							"constraints": "NOT NULL DEFAULT now()"
						}
					],
					"uniqueConstraint": null,
					"indexes": [
						"tenant_id",
						"subscription_id",
						"variant_id"
					],
					"rls": true
				},
				{
					"table": "app_settings",
					"columns": [
						{
							"name": "id",
							"type": "UUID",
							"constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"
						},
						{
							"name": "tenant_id",
							"type": "UUID",
							"constraints": "NOT NULL"
						},
						{
							"name": "email_subject",
							"type": "TEXT",
							"constraints": "NOT NULL DEFAULT 'Good news! {{product_title}} is back in stock'"
						},
						{
							"name": "email_body_template",
							"type": "TEXT",
							"constraints": "NOT NULL"
						},
						{
							"name": "auto_notify_enabled",
							"type": "BOOLEAN",
							"constraints": "NOT NULL DEFAULT true"
						},
						{
							"name": "created_at",
							"type": "TIMESTAMPTZ",
							"constraints": "NOT NULL DEFAULT now()"
						},
						{
							"name": "updated_at",
							"type": "TIMESTAMPTZ",
							"constraints": "NOT NULL DEFAULT now()"
						}
					],
					"uniqueConstraint": [
						"tenant_id"
					],
					"indexes": [
						"tenant_id"
					],
					"rls": true
				}
			],
			"webhookContract": {
				"webhookTopics": [
					"inventory_levels/update"
				],
				"payloadFields": [
					"inventory_item_id",
					"location_id",
					"available"
				],
				"handlerMustProduce": "For the incoming inventory_item_id, resolve the associated variant_id and product_id by querying Shopify Admin API. Then load the prior last_known_quantity from inventory_snapshots for this tenant + inventory_item_id + location_id combination (null if never seen). If the prior quantity was zero or negative (or null, treated as first-seen positive restock) and the incoming available quantity is positive, fetch all active back_in_stock_subscriptions rows for this tenant + variant_id and send email notifications to each subscriber. Update inventory_snapshots with the new quantity and mark notified subscriptions with notified_at and status='notified'."
			},
			"cronContract": {
				"schedule": "0 */6 * * *",
				"handlerMustProduce": "Collect all distinct (inventory_item_id, location_id, variant_id) tuples from inventory_snapshots joined with active back_in_stock_subscriptions for the tenant. Bulk-fetch current inventory levels from Shopify Admin API for all collected inventory_item_id + location_id pairs in a single batched request. For each item where the fetched available quantity is positive and last_known_quantity was zero, null, or negative: load all active subscriptions for that variant_id, send email notifications, update inventory_snapshots.last_known_quantity, and mark subscriptions as notified. Also update last_known_quantity for items that moved from positive to zero without sending notifications."
			},
			"widgetTargetTemplates": [
				"product"
			],
			"widgetApiCatalog": [
				{
					"path": "/subscribe",
					"method": "POST",
					"description": "Record a customer's back-in-stock subscription for a specific variant.",
					"requestShape": {
						"email": "string",
						"product_id": "number",
						"variant_id": "number",
						"product_title": "string",
						"variant_title": "string | null",
						"product_image_url": "string | null",
						"customer_id": "number | null"
					},
					"responseShape": {
						"success": "boolean",
						"message": "string",
						"already_subscribed": "boolean"
					}
				},
				{
					"path": "/subscription-status",
					"method": "GET",
					"description": "Check whether the current visitor is already subscribed for a variant.",
					"requestShape": {
						"email": "string",
						"variant_id": "number"
					},
					"responseShape": {
						"subscribed": "boolean",
						"status": "string | null"
					}
				}
			],
			"adminApiCatalog": [
				{
					"path": "/subscriptions",
					"method": "GET",
					"description": "List all subscriptions with optional filters.",
					"requestShape": {
						"status": "string | null",
						"product_id": "number | null",
						"page": "number",
						"page_size": "number"
					},
					"responseShape": {
						"subscriptions": [
							{
								"id": "string",
								"email": "string",
								"customer_id": "number | null",
								"product_id": "number",
								"variant_id": "number",
								"product_title": "string",
								"variant_title": "string | null",
								"product_image_url": "string | null",
								"status": "string",
								"notified_at": "string | null",
								"created_at": "string"
							}
						],
						"total": "number",
						"page": "number",
						"page_size": "number"
					}
				},
				{
					"path": "/subscriptions/:id",
					"method": "GET",
					"description": "Fetch a single subscription by ID.",
					"requestShape": {},
					"responseShape": {
						"id": "string",
						"email": "string",
						"customer_id": "number | null",
						"product_id": "number",
						"variant_id": "number",
						"product_title": "string",
						"variant_title": "string | null",
						"product_image_url": "string | null",
						"status": "string",
						"notified_at": "string | null",
						"created_at": "string"
					}
				},
				{
					"path": "/subscriptions/:id/delete",
					"method": "POST",
					"description": "Delete a single subscription.",
					"requestShape": {},
					"responseShape": {
						"success": "boolean"
					}
				},
				{
					"path": "/notify/variant",
					"method": "POST",
					"description": "Manually trigger email notifications to all active subscribers of a specific variant.",
					"requestShape": {
						"variant_id": "number"
					},
					"responseShape": {
						"success": "boolean",
						"notified_count": "number"
					}
				},
				{
					"path": "/notify/product",
					"method": "POST",
					"description": "Manually trigger email notifications to all active subscribers across all variants of a product.",
					"requestShape": {
						"product_id": "number"
					},
					"responseShape": {
						"success": "boolean",
						"notified_count": "number"
					}
				},
				{
					"path": "/notification-logs",
					"method": "GET",
					"description": "List notification send history with optional filters.",
					"requestShape": {
						"variant_id": "number | null",
						"trigger_source": "string | null",
						"page": "number",
						"page_size": "number"
					},
					"responseShape": {
						"logs": [
							{
								"id": "string",
								"subscription_id": "string",
								"variant_id": "number",
								"email": "string",
								"trigger_source": "string",
								"sent_at": "string"
							}
						],
						"total": "number",
						"page": "number",
						"page_size": "number"
					}
				},
				{
					"path": "/settings",
					"method": "GET",
					"description": "Fetch the merchant's app settings.",
					"requestShape": {},
					"responseShape": {
						"email_subject": "string",
						"email_body_template": "string",
						"auto_notify_enabled": "boolean"
					}
				},
				{
					"path": "/settings",
					"method": "POST",
					"description": "Save the merchant's app settings.",
					"requestShape": {
						"email_subject": "string",
						"email_body_template": "string",
						"auto_notify_enabled": "boolean"
					},
					"responseShape": {
						"success": "boolean"
					}
				},
				{
					"path": "/run",
					"method": "POST",
					"description": "Manually trigger the cron restock-check job immediately.",
					"requestShape": {},
					"responseShape": {
						"success": "boolean",
						"notified_count": "number"
					}
				}
			]
		}
	},
	"validation_errors": []
}