{
  "prompt": "All product images \u2264400\u00d7400 are automatically optimized to 400\u00d7400 and replaced nightly.",
  "intent": {
    "triggerTypes": [
      "cron"
    ],
    "resources": [
      "ProductImage"
    ],
    "desiredOutcome": "All product images \u2264400\u00d7400 are automatically optimized to 400\u00d7400 and replaced nightly.",
    "cronSchedule": "0 2 * * *",
    "appCategory": "backend"
  },
  "plan": {
    "shopifyPlan": {
      "webhookTopics": [],
      "cronSchedule": "0 2 * * *"
    },
    "appContracts": {
      "feasibility": "feasible",
      "blockedReason": null,
      "complexity": "medium",
      "stateMachine": null,
      "platformGaps": [
        {
          "gap": "Shopify does not allow direct replacement of a product image's source URL in-place; images must be deleted and re-uploaded.",
          "mitigation": "Handler downloads the original image via outbound HTTPS, resizes it to 400\u00d7400 using sharp, uploads the new file via ctx.services.files, then calls Shopify Admin REST to delete the old productImage and create a new one with the hosted URL. Position and alt text are preserved across the swap."
        }
      ],
      "cronBatching": {
        "required": true,
        "description": "Before the per-image processing loop begins, the handler bulk-fetches all products and their associated images from the Shopify Admin API in paginated batches (using cursor-based pagination) so that individual per-image Shopify API calls are minimised during iteration."
      },
      "dbContracts": [
        {
          "table": "image_optimization_log",
          "columns": [
            {
              "name": "id",
              "type": "UUID",
              "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"
            },
            {
              "name": "tenant_id",
              "type": "UUID",
              "constraints": "NOT NULL"
            },
            {
              "name": "product_id",
              "type": "BIGINT",
              "constraints": "NOT NULL"
            },
            {
              "name": "old_image_id",
              "type": "BIGINT",
              "constraints": "NOT NULL"
            },
            {
              "name": "new_image_id",
              "type": "BIGINT",
              "constraints": "NULL"
            },
            {
              "name": "original_width",
              "type": "INTEGER",
              "constraints": "NOT NULL"
            },
            {
              "name": "original_height",
              "type": "INTEGER",
              "constraints": "NOT NULL"
            },
            {
              "name": "original_src",
              "type": "TEXT",
              "constraints": "NOT NULL"
            },
            {
              "name": "status",
              "type": "TEXT",
              "constraints": "NOT NULL DEFAULT 'pending'"
            },
            {
              "name": "error_message",
              "type": "TEXT",
              "constraints": "NULL"
            },
            {
              "name": "run_id",
              "type": "UUID",
              "constraints": "NOT NULL"
            },
            {
              "name": "created_at",
              "type": "TIMESTAMPTZ",
              "constraints": "NOT NULL DEFAULT now()"
            },
            {
              "name": "completed_at",
              "type": "TIMESTAMPTZ",
              "constraints": "NULL"
            }
          ],
          "uniqueConstraint": null,
          "indexes": [
            "tenant_id",
            "run_id",
            "product_id"
          ],
          "rls": true
        },
        {
          "table": "cron_run_summary",
          "columns": [
            {
              "name": "id",
              "type": "UUID",
              "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"
            },
            {
              "name": "tenant_id",
              "type": "UUID",
              "constraints": "NOT NULL"
            },
            {
              "name": "run_id",
              "type": "UUID",
              "constraints": "NOT NULL"
            },
            {
              "name": "started_at",
              "type": "TIMESTAMPTZ",
              "constraints": "NOT NULL DEFAULT now()"
            },
            {
              "name": "finished_at",
              "type": "TIMESTAMPTZ",
              "constraints": "NULL"
            },
            {
              "name": "total_images",
              "type": "INTEGER",
              "constraints": "NOT NULL DEFAULT 0"
            },
            {
              "name": "optimized_count",
              "type": "INTEGER",
              "constraints": "NOT NULL DEFAULT 0"
            },
            {
              "name": "skipped_count",
              "type": "INTEGER",
              "constraints": "NOT NULL DEFAULT 0"
            },
            {
              "name": "error_count",
              "type": "INTEGER",
              "constraints": "NOT NULL DEFAULT 0"
            },
            {
              "name": "triggered_by",
              "type": "TEXT",
              "constraints": "NOT NULL DEFAULT 'cron'"
            }
          ],
          "uniqueConstraint": [
            "tenant_id",
            "run_id"
          ],
          "indexes": [
            "tenant_id"
          ],
          "rls": true
        }
      ],
      "webhookContract": null,
      "cronContract": {
        "handlerMustProduce": "For each cron execution: (1) generate a new run_id UUID and insert a cron_run_summary row; (2) bulk-fetch all products with their images from Shopify Admin API using paginated cursor iteration; (3) for each image where width \u2264 400 AND height \u2264 400, download the image binary via outbound HTTPS, resize to exactly 400\u00d7400 using sharp (padding/letterboxing to preserve aspect ratio), upload the resized binary via ctx.services.files to obtain a hosted URL, call Shopify Admin REST to create a new product image with the hosted URL preserving original position and alt text, then delete the old product image; (4) write an image_optimization_log row per processed image recording old_image_id, new_image_id, original dimensions, original_src, status ('optimized', 'skipped', or 'error'), error_message if applicable, completed_at, and the run_id; (5) update the cron_run_summary row with finished_at and final counts."
      },
      "widgetTargetTemplates": null,
      "widgetApiCatalog": null,
      "adminApiCatalog": [
        {
          "path": "/run",
          "method": "POST",
          "requestShape": {},
          "responseShape": {
            "run_id": "string",
            "started_at": "string"
          }
        },
        {
          "path": "/runs",
          "method": "GET",
          "requestShape": {},
          "responseShape": {
            "runs": [
              {
                "run_id": "string",
                "started_at": "string",
                "finished_at": "string | null",
                "total_images": "number",
                "optimized_count": "number",
                "skipped_count": "number",
                "error_count": "number",
                "triggered_by": "string"
              }
            ]
          }
        },
        {
          "path": "/runs/:run_id/logs",
          "method": "GET",
          "requestShape": {},
          "responseShape": {
            "logs": [
              {
                "id": "string",
                "product_id": "number",
                "old_image_id": "number",
                "new_image_id": "number | null",
                "original_width": "number",
                "original_height": "number",
                "original_src": "string",
                "status": "string",
                "error_message": "string | null",
                "completed_at": "string | null"
              }
            ]
          }
        }
      ]
    }
  },
  "validation_errors": []
}