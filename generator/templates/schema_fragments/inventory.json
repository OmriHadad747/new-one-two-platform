{
  "resource": "inventory",
  "webhookTopics": ["inventory_levels/update", "inventory_items/update"],
  "restEndpoints": [
    {
      "method": "GET",
      "path": "/inventory_levels.json?inventory_item_ids={id}",
      "description": "Get inventory level for a specific inventory item. Returns available quantity per location.",
      "responseShape": {
        "inventory_levels": [
          { "inventory_item_id": 111, "location_id": 222, "available": 10, "updated_at": "2024-01-01T10:00:00-05:00" }
        ]
      }
    },
    {
      "method": "GET",
      "path": "/inventory_items/{id}.json",
      "description": "Get an inventory item. Use variant_id to look up the associated variant.",
      "responseShape": {
        "inventory_item": { "id": 111, "sku": "SHIRT-RED-M", "tracked": true, "variant_id": 999 }
      }
    },
    {
      "method": "POST",
      "path": "/inventory_levels/adjust.json",
      "description": "Adjust inventory level by a relative amount",
      "bodyShape": { "location_id": 222, "inventory_item_id": 111, "available_adjustment": -5 }
    }
  ],
  "webhookPayloadShape": {
    "inventory_item_id": 111,
    "location_id": 222,
    "available": 3,
    "updated_at": "2024-01-01T10:00:00-05:00"
  },
  "note": "inventory_levels/update fires when available quantity changes. ctx.payload.available is the new quantity."
}
