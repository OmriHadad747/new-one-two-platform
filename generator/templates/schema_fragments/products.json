{
  "resource": "products",
  "webhookTopics": ["products/create", "products/update", "products/delete"],
  "restEndpoints": [
    {
      "method": "GET",
      "path": "/products.json",
      "description": "List products. Key params: limit=<1-250>, status=active|draft|archived",
      "responseShape": {
        "products": [
          {
            "id": 333,
            "title": "My Product",
            "status": "active",
            "variants": [
              { "id": 111, "title": "Default", "price": "29.99", "inventory_item_id": 444, "inventory_quantity": 10 }
            ]
          }
        ]
      }
    },
    {
      "method": "GET",
      "path": "/products/{id}.json",
      "description": "Get a single product by ID"
    },
    {
      "method": "GET",
      "path": "/variants/{id}.json",
      "description": "Get a single variant by ID",
      "responseShape": {
        "variant": { "id": 111, "product_id": 333, "title": "M / Red", "price": "29.99", "inventory_quantity": 5 }
      }
    }
  ],
  "webhookPayloadShape": {
    "id": 333,
    "title": "My Product",
    "status": "active",
    "variants": [
      { "id": 111, "inventory_item_id": 444, "inventory_quantity": 10 }
    ]
  }
}
