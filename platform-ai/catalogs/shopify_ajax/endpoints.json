      "id": "search.predictive",
      "category": "search",
      "method": "GET",
      "path": "/search/suggest.json",
      "purpose": "Predictive (type-ahead) search across products, collections, pages, articles.",
      "path_params": [],
      "query_params": [
        {
          "name": "q",
          "type": "string",
          "required": true,
          "description": "the partial query"
        },
        {
          "name": "resources[type]",
          "type": "string",
          "required": false,
          "description": "comma-separated subset of: product, page, article, collection, query. Default 'query,product,collection,page'"
        },
        {
          "name": "resources[limit]",
          "type": "number",
          "required": false,
          "description": "1-10; default 10"
        },
        {
          "name": "resources[limit_scope]",
          "type": "string",
          "required": false,
          "description": "'all' (cap total) or 'each' (cap per type). Default 'all'"
        },
        {
          "name": "resources[options][unavailable_products]",
          "type": "string",
          "required": false,
          "description": "'show', 'hide', or 'last' (default 'last')"
        },
        {
          "name": "resources[options][fields]",
          "type": "string",
          "required": false,
          "description": "comma-separated subset of: author, body, product_type, tag, title, variants.barcode, variants.sku, variants.title, vendor"
        }
      ],
      "body_params": null,
      "response_top_fields": [
