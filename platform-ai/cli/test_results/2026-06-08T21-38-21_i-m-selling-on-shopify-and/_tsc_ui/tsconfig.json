{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@platform/admin-sdk": [
        "./sdk/admin"
      ],
      "@platform/storefront-sdk": [
        "./sdk/storefront"
      ]
    }
  },
  "include": [
    "admin/ui.ts",
    "widget/widget.ts"
  ]
}