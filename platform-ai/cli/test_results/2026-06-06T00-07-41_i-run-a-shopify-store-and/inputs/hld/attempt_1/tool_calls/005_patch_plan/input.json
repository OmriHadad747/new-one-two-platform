          "payloadBindings": [
            {
              "signalField": "inventory item identifier",
              "source": "payload",
              "payloadPath": "inventory_item_id",
              "resolution": null
            },
            {
              "signalField": "available quantity",
              "source": "payload",
              "payloadPath": "available",
              "resolution": null
            },
            {
              "signalField": "location identifier",
              "source": "payload",
              "payloadPath": "location_id",
              "resolution": null
            },
            {
              "signalField": "inventory level updated at",
              "source": "payload",
              "payloadPath": "updated_at",
              "resolution": null
            }
          ]
        },
        {
          "kind": "external-event",
          "event": "a product is deleted from the store",
          "signalFields": [
            "product identifier"
          ],
          "idempotency": "if the product's waitlist entries are already removed, treat the event as a no-op",
          "shopifyTopic": "products/delete",
          "payloadBindings": [
            {
              "signalField": "product identifier",
              "source": "payload",
              "payloadPath": "id",
              "resolution": null
            }
          ]
        },
        {
          "kind": "external-event",
          "event": "an order is paid by a customer",
          "signalFields": [
            "order identifier",
            "buyer email",
            "purchased item variant identifiers"
          ],
          "idempotency": "if a conversion_event already exists for this order identifier, treat the event as a no-op",
          "shopifyTopic": "orders/paid",
          "payloadBindings": [
            {
              "signalField": "order identifier",
              "source": "payload",
              "payloadPath": "id",
              "resolution": null
            },
            {
              "signalField": "buyer email",
              "source": "payload",
              "payloadPath": "email",
              "resolution": null
            },
            {
              "signalField": "purchased item variant identifiers",
              "source": "payload",
              "payloadPath": "line_items[].variant_id",
              "resolution": null
            }
          ]
        },
        {
          "kind": "schedule",
          "cadence": "every hour",
          "jobPurpose": "Dispatch back-in-stock notification emails for pending restock events, respecting quiet hours and per-restock notify quotas.",
          "perTickWork": "For each pending restock_event not yet fully dispatched, select waitlist entries at the front of the queue up to the configured notify-quota that have not already been notified for this restock event, create a notification_batch, enqueue one notification_record per recipient, send emails, and mark the batch dispatched.",
          "bulkFetchRule": false
        }
      ]
    },
    {
      "path": "persistence[restock_events].columns",
      "value": [
        {
          "name": "id",
          "role": "identifier",
          "nullable": false,
          "purpose": null
        },
        {
          "name": "item_key",
          "role": "reference",
          "nullable": false,
          "purpose": "item that became available, matches waitlist_entries.item_key"
        },
        {
          "name": "inventory_item_external_id",
          "role": "reference",
          "nullable": false,
          "purpose": "Shopify inventory item id from the webhook, part of the dedup key"
        },
        {
          "name": "inventory_level_updated_at",
          "role": "timestamp",
          "nullable": false,
          "purpose": "value of updated_at bound from the inventory_levels/update webhook payload; used as the dedup key partner so two re-deliveries of the same webhook event carry the same timestamp and the unique constraint on (inventory_item_external_id, inventory_level_updated_at) prevents a duplicate restock_event row"
        },
        {
          "name": "status",
          "role": "status",
          "nullable": false,
          "purpose": "lifecycle: pending (awaiting dispatch), dispatching (job in progress), completed (all eligible subscribers notified for this event)"
        },
        {
          "name": "created_at",
          "role": "timestamp",
          "nullable": false,
          "purpose": null
        }
      ]
