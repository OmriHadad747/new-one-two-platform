{
  "edits": [
    {
      "path": "persistence[app_settings].columns",
      "value": [
        {
          "name": "id",
          "role": "identifier",
          "nullable": false,
          "purpose": "singleton row; application code ensures exactly one row exists"
        },
        {
          "name": "quiet_hours_start",
          "role": "count",
          "nullable": false,
          "purpose": "hour of day 0-23 when the quiet window begins; emails are deferred if the current hour is within the window"
        },
        {
          "name": "quiet_hours_end",
          "role": "count",
          "nullable": false,
          "purpose": "hour of day 0-23 when the quiet window ends; deferred batches resume at this hour"
        },
        {
          "name": "notify_quota",
          "role": "count",
          "nullable": false,
          "purpose": "maximum subscribers to notify per restock event dispatch run; remainder waits for the next restock"
        },
        {
          "name": "conversion_window_days",
          "role": "count",
          "nullable": false,
          "purpose": "number of days after a notification is sent within which a purchase counts as a conversion"
        },
        {
          "name": "email_subject_template",
          "role": "text",
          "nullable": false,
          "purpose": "merchant-configured email subject line template, may include placeholders for product name and item details"
        }
      ]
    },
