      "platformGaps": [
        {
          "gap": "Shopify does not expose raw image pixel dimensions directly in the Admin API \u2014 image width/height must be inferred from the CDN URL or fetched via image metadata.",
          "mitigation": "Download each image via outbound HTTPS to read its dimensions using sharp (image processing library), then apply the \u2264400\u00d7400px filter before replacing."
        },
        {
          "gap": "No batch write API for product images or collection images \u2014 each image replacement requires individual Shopify Admin API calls.",
          "mitigation": "Pre-fetch all product and collection image listings in bulk before the loop; per-item image upload and delete calls inside the loop are unavoidable for this resource type."
        },
        {
          "gap": "Image replacement jobs are long-running and cannot complete within a synchronous HTTP response cycle when many images are involved.",
          "mitigation": "Persist a job record in PostgreSQL on trigger, process asynchronously in a background worker loop, and expose a GET /job/status route so the Admin UI can poll for progress."
        }
