{
  "prompt": "I want to reward customers for buying from me. Like give them points every time they order and let them see their total somewhere on the site. Nothing complicated, just something that makes them feel appreciated and want to come back.",
  "intent": {
    "triggerTypes": [
      "webhook",
      "widget"
    ],
    "resources": [
      "orders",
      "customers"
    ],
    "desiredOutcome": "Customers earn loyalty points for each purchase and view their total points balance on the storefront.",
    "cronSchedule": null,
    "appCategory": "storefront_backend"
  },
  "plan": {
    "shopifyPlan": {
      "webhookTopics": [
        "orders/paid"
      ],
      "cronSchedule": null
    },
    "appContracts": {
      "feasibility": "feasible",
      "blockedReason": null,
      "complexity": "medium",
      "stateMachine": null,
      "platformGaps": [],
      "cronBatching": null,
      "dbContracts": [
        {
          "table": "loyalty_points",
          "columns": [
            {
              "name": "id",
              "type": "UUID",
              "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"
            },
            {
              "name": "tenant_id",
              "type": "UUID",
              "constraints": "NOT NULL"
            },
            {
              "name": "customer_id",
              "type": "BIGINT",
              "constraints": "NOT NULL"
            },
            {
              "name": "points",
              "type": "INTEGER",
              "constraints": "NOT NULL DEFAULT 0"
            },
            {
              "name": "created_at",
              "type": "TIMESTAMPTZ",
              "constraints": "NOT NULL DEFAULT now()"
            }
          ],
          "uniqueConstraint": [
            "tenant_id",
            "customer_id"
          ],
          "indexes": [
            "tenant_id",
            "customer_id"
          ],
          "rls": true
        },
        {
          "table": "loyalty_transactions",
          "columns": [
            {
              "name": "id",
              "type": "UUID",
              "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"
            },
            {
              "name": "tenant_id",
              "type": "UUID",
              "constraints": "NOT NULL"
            },
            {
              "name": "customer_id",
              "type": "BIGINT",
              "constraints": "NOT NULL"
            },
            {
              "name": "order_id",
              "type": "BIGINT",
              "constraints": "NOT NULL"
            },
            {
              "name": "points",
              "type": "INTEGER",
              "constraints": "NOT NULL"
            },
            {
              "name": "created_at",
              "type": "TIMESTAMPTZ",
              "constraints": "NOT NULL DEFAULT now()"
            }
          ],
          "uniqueConstraint": [
            "tenant_id",
            "order_id"
          ],
          "indexes": [
            "tenant_id",
            "customer_id",
            "order_id"
          ],
          "rls": true
        }
      ],
      "webhookContract": {
        "payloadFields": [
          "id",
          "customer",
          "total_price",
          "financial_status"
        ],
        "handlerMustProduce": "The Shopify customer ID from the order payload (payload.customer.id) and the points to award calculated from the order total (1 point per whole currency unit of payload.total_price). The handler must be idempotent: skip processing if a loyalty_transactions record already exists for this order_id and tenant_id."
      },
      "cronContract": null,
      "widgetTargetTemplates": [
        "product",
        "index",
        "collection"
      ],
      "widgetApiCatalog": [
        {
          "path": "/loyalty/balance",
          "method": "GET",
          "requestShape": {
            "customerId": "number"
          },
          "responseShape": {
            "customerId": "number",
            "points": "number",
            "found": "boolean"
          }
        }
      ],
      "adminApiCatalog": null
    }
  },
  "validation_errors": []
}