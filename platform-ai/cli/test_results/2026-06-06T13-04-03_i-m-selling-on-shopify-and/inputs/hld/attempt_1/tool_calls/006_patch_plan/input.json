          "usesConfig": false,
          "usesWorkflow": false
        },
        {
          "id": "create-bundle-discount",
          "description": "Create a new automatic app discount in Shopify for a bundle that has no backing discount yet.",
          "kind": "write",
          "dataNeeds": [
            "bundle discount title",
            "discount kind",
            "discount ratio",
            "discount amount",
            "tier rules",
            "bundle item variants",
            "enabled flag"
          ],
          "integration": "shopify-admin",
          "shopifySteps": [
            {
              "op": "discountAutomaticAppCreate",
              "produces": "the new automatic discount node external id",
              "consumes": "the bundle discount title and function configuration encoding the bundle items and discount/tier rules"
            }
          ],
          "returnsList": false,
          "touchesMoney": true,
          "usesConfig": false,
          "usesWorkflow": false
        },
        {
          "id": "update-bundle-discount",
