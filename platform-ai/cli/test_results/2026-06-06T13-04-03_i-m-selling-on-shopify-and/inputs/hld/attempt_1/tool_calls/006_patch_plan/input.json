        {
          "id": "save-bundle-definition",
          "description": "Create or update a bundle's definition, its ordered items, and its discount tiers from the admin form.",
          "kind": "write",
          "dataNeeds": [
            "bundle id",
            "bundle name",
            "bundle type",
            "anchor product external id",
            "required item count",
            "discount kind",
            "discount ratio",
            "discount amount",
            "tier rules",
