          "kind": "write",
          "dataNeeds": [
            "existing discount external id",
            "bundle discount title",
            "discount kind",
            "discount ratio",
            "discount amount",
            "tier rules",
            "bundle item variants",
            "enabled flag"
          ],
          "integration": "shopify-admin",
          "shopifySteps": [
            {
              "op": "discountAutomaticAppUpdate",
              "produces": "the updated automatic discount status",
              "consumes": "the existing discount external id and the revised function configuration"
            }
          ],
          "returnsList": false,
          "touchesMoney": true,
          "usesConfig": false,
          "usesWorkflow": false
        },
        {
