{
  "name": "Bundle Discounts",
  "description": "Merchants create fixed and flexible product bundles with tiered discounts; customers select items on product pages and add them to cart with discount auto-applied.",
  "database": {
    "tables": [
      {
        "name": "bundles",
        "purpose": "Stores each bundle's identity, mode (fixed or flexible), enabled state, and a system-managed health status reflecting variant availability.",
        "columns": [
          {
            "name": "id",
            "sqlType": "UUID",
            "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()",
            "purpose": "internal bundle id"
          },
          {
            "name": "title",
            "sqlType": "TEXT",
            "constraints": "NOT NULL"
          },
          {
            "name": "description",
            "sqlType": "TEXT",
            "constraints": "NULL"
          },
          {
            "name": "mode",
            "sqlType": "TEXT",
            "constraints": "NOT NULL DEFAULT 'flexible'",
            "enum": [
              "fixed",
              "flexible"
            ],
            "purpose": "fixed bundles have a predefined set; flexible bundles let customers pick from a pool"
          },
          {
            "name": "enabled",
            "sqlType": "BOOLEAN",
            "constraints": "NOT NULL DEFAULT false"
          },
          {
            "name": "health_status",
            "sqlType": "TEXT",
            "constraints": "NOT NULL DEFAULT 'healthy'",
            "enum": [
              "healthy",
              "warned",
              "auto_disabled"
            ],
            "purpose": "merchant-facing health signal driven by variant availability changes"
          },
          {
            "name": "created_at",
            "sqlType": "TIMESTAMPTZ",
            "constraints": "NOT NULL DEFAULT now()"
          },
          {
            "name": "updated_at",
            "sqlType": "TIMESTAMPTZ",
            "constraints": "NOT NULL DEFAULT now()"
          }
        ],
        "uniqueConstraint": [],
        "indexes": [
          [
            "enabled",
            "created_at"
          ],
          [
            "health_status"
          ],
          [
            "created_at"
          ]
        ],
        "foreignKeys": []
      },
      {
        "name": "bundle_items",
        "purpose": "Stores the variant-level products belonging to each bundle, including the last-observed availability of each variant.",
        "columns": [
          {
            "name": "id",
            "sqlType": "UUID",
            "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"
          },
          {
            "name": "bundle_id",
            "sqlType": "UUID",
            "constraints": "NOT NULL REFERENCES bundles(id) ON DELETE CASCADE",
            "purpose": "the bundle this item belongs to"
          },
          {
            "name": "variant_external_id",
            "sqlType": "BIGINT",
            "constraints": "NOT NULL",
            "purpose": "Shopify variant ID"
          },
          {
            "name": "product_external_id",
            "sqlType": "BIGINT",
            "constraints": "NOT NULL",
            "purpose": "Shopify product ID, used for deletion event matching"
          },
          {
            "name": "observed_availability",
            "sqlType": "TEXT",
            "constraints": "NOT NULL DEFAULT 'available'",
            "enum": [
              "available",
              "out_of_stock",
              "deleted"
            ],
            "purpose": "last known availability state"
          },
          {
            "name": "added_at",
            "sqlType": "TIMESTAMPTZ",
            "constraints": "NOT NULL DEFAULT now()"
          }
        ],
        "uniqueConstraint": [
          "bundle_id",
          "variant_external_id"
        ],
        "indexes": [
          [
            "bundle_id",
            "added_at"
          ],
          [
            "variant_external_id"
          ],
          [
            "bundle_id",
            "observed_availability"
          ]
        ],
        "foreignKeys": []
      },
      {
        "name": "bundle_tiers",
        "purpose": "Stores each discount tier for a bundle, including minimum item count and discount rate, ordered by merchant-defined display sequence.",
        "columns": [
          {
            "name": "id",
            "sqlType": "UUID",
            "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"
          },
          {
            "name": "bundle_id",
            "sqlType": "UUID",
            "constraints": "NOT NULL REFERENCES bundles(id) ON DELETE CASCADE",
            "purpose": "the bundle this tier belongs to"
          },
          {
            "name": "minimum_item_count",
            "sqlType": "INTEGER",
            "constraints": "NOT NULL"
          },
          {
            "name": "discount_rate",
            "sqlType": "INTEGER",
            "constraints": "NOT NULL",
            "purpose": "discount percentage as integer (e.g. 10 = 10%)"
          },
          {
            "name": "display_order",
            "sqlType": "INTEGER",
            "constraints": "NOT NULL"
          },
          {
            "name": "created_at",
            "sqlType": "TIMESTAMPTZ",
            "constraints": "NOT NULL DEFAULT now()"
          },
          {
            "name": "updated_at",
            "sqlType": "TIMESTAMPTZ",
            "constraints": "NOT NULL DEFAULT now()"
          }
        ],
        "uniqueConstraint": [
          "bundle_id",
          "minimum_item_count"
        ],
        "indexes": [
          [
            "bundle_id",
            "display_order"
          ],
          [
            "bundle_id",
            "minimum_item_count"
          ]
        ],
        "foreignKeys": []
      },
      {
        "name": "bundle_purchase_records",
        "purpose": "Records every bundle present in a paid order, keyed by order external id and bundle id for idempotency.",
        "columns": [
          {
            "name": "id",
            "sqlType": "UUID",
            "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"
          },
          {
            "name": "bundle_id",
            "sqlType": "UUID",
            "constraints": "NOT NULL REFERENCES bundles(id) ON DELETE CASCADE",
            "purpose": "the bundle that was purchased"
          },
          {
            "name": "order_external_id",
            "sqlType": "BIGINT",
            "constraints": "NOT NULL",
            "purpose": "Shopify order ID"
          },
          {
            "name": "order_placed_at",
            "sqlType": "TIMESTAMPTZ",
            "constraints": "NOT NULL"
          },
          {
            "name": "variant_external_ids",
            "sqlType": "TEXT",
            "constraints": "NOT NULL",
            "purpose": "JSON-serialized array of Shopify variant IDs selected at purchase time"
          },
          {
            "name": "item_count",
            "sqlType": "INTEGER",
            "constraints": "NOT NULL"
          },
          {
            "name": "discount_rate_applied",
            "sqlType": "INTEGER",
            "constraints": "NOT NULL",
            "purpose": "integer percentage applied (e.g. 10 = 10%)"
          },
          {
            "name": "order_total",
            "sqlType": "BIGINT",
            "constraints": "NOT NULL",
            "purpose": "order total in minor currency units"
          },
          {
            "name": "order_currency",
            "sqlType": "TEXT",
            "constraints": "NOT NULL",
            "purpose": "ISO currency code"
          },
          {
            "name": "recorded_at",
            "sqlType": "TIMESTAMPTZ",
            "constraints": "NOT NULL DEFAULT now()"
          }
        ],
        "uniqueConstraint": [
          "order_external_id",
          "bundle_id"
        ],
        "indexes": [
          [
            "bundle_id",
            "order_placed_at"
          ],
          [
            "order_placed_at"
          ],
          [
            "order_external_id"
          ]
        ],
        "foreignKeys": []
      },
      {
        "name": "bundle_health_events",
        "purpose": "Logs every automated health change applied to a bundle so merchants can audit why a bundle changed state.",
        "columns": [
          {
            "name": "id",
            "sqlType": "UUID",
            "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"
          },
          {
            "name": "bundle_id",
            "sqlType": "UUID",
            "constraints": "NOT NULL REFERENCES bundles(id) ON DELETE CASCADE",
            "purpose": "the bundle whose health changed"
          },
          {
            "name": "event_kind",
            "sqlType": "TEXT",
            "constraints": "NOT NULL",
            "enum": [
              "auto_disabled",
              "warned",
              "cleared"
            ],
            "purpose": "type of health change"
          },
          {
            "name": "affected_variant_external_id",
            "sqlType": "BIGINT",
            "constraints": "NULL",
            "purpose": "the variant whose availability triggered this health change"
          },
          {
            "name": "reason",
            "sqlType": "TEXT",
            "constraints": "NOT NULL"
          },
          {
            "name": "occurred_at",
            "sqlType": "TIMESTAMPTZ",
            "constraints": "NOT NULL DEFAULT now()"
          }
        ],
        "uniqueConstraint": [],
        "indexes": [
          [
            "bundle_id",
            "occurred_at"
          ]
        ],
        "foreignKeys": []
      }
    ]
  },
  "shopifyIntegration": {
    "webhookTopics": [
      "orders/paid",
      "inventory_levels/update",
      "products/delete"
    ],
    "cronSchedule": null
  },
  "httpRoutes": {
    "admin": [
      {
        "method": "GET",
        "path": "/admin/bundles",
        "handler": "listBundles",
        "description": "Paginated list of bundles with mode, status, tier count"
      },
      {
        "method": "POST",
        "path": "/admin/bundles/create",
        "handler": "createBundle",
        "description": "Create a new bundle in disabled state"
      },
      {
        "method": "PUT",
        "path": "/admin/bundles/update",
        "handler": "updateBundle",
        "description": "Update bundle title, description, mode, or enabled flag"
      },
      {
        "method": "POST",
        "path": "/admin/bundles/remove",
        "handler": "removeBundle",
        "description": "Delete a bundle and cascade-remove items and tiers"
      },
      {
        "method": "POST",
        "path": "/admin/bundles/clone",
        "handler": "cloneBundle",
        "description": "Duplicate a bundle with all items and tiers"
      },
      {
        "method": "POST",
        "path": "/admin/bundles/bulk-status",
        "handler": "bulkSetBundleStatus",
        "description": "Enable or disable a set of bundles"
      },
      {
        "method": "GET",
        "path": "/admin/bundles/items",
        "handler": "listBundleItems",
        "description": "Paginated list of variant items for a bundle"
      },
      {
        "method": "POST",
        "path": "/admin/bundles/items/save",
        "handler": "saveBundleItems",
        "description": "Replace the full item set for a bundle"
      },
      {
        "method": "GET",
        "path": "/admin/bundles/tiers",
        "handler": "listBundleTiers",
        "description": "All discount tiers for a bundle in display order"
      },
      {
        "method": "POST",
        "path": "/admin/bundles/tiers/save",
        "handler": "saveBundleTiers",
        "description": "Replace the full tier list for a bundle"
      },
      {
        "method": "GET",
        "path": "/admin/purchase-history",
        "handler": "listPurchaseHistory",
        "description": "Paginated purchase history log"
      }
    ],
    "widget": [
      {
        "method": "GET",
        "path": "/widget/bundle",
        "handler": "getBundleForWidget",
        "description": "Bundle config, tiers, and item availability for widget render"
      },
      {
        "method": "POST",
        "path": "/widget/bundle/validate",
        "handler": "validateBundleSelection",
        "description": "Validate customer selection and return earned tier"
      },
      {
        "method": "POST",
        "path": "/widget/cart/add",
        "handler": "addBundleToCart",
        "description": "Add validated bundle selection to cart with discount"
      }
    ]
  }
}