{
  "name": "new-one-two",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel --filter=!@new-one-two/harness",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:migrate": "workspace @new-one-two/db migrate",
    "db:seed": "workspace @new-one-two/db seed",
    "db:generate": "workspace @new-one-two/db generate"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.2.0",
    "tsx": "^4.21.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
