# ─── Shopify PaaS Platform — Environment Variables ────────────────────────────
# Copy to .env and fill in the required values. Never commit .env to git.

# ─── Node ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://new_one_two_u:paas_dev_password@localhost:5432/new_one_two
# Production (Cloud SQL, Supabase, etc.):
# DATABASE_URL=postgresql://user:pass@host:5432/new_one_two

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
# Production (Memorystore / Upstash):
# REDIS_HOST=10.x.x.x
# REDIS_TLS=true

# ─── GCP ──────────────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=local
# Production: use Workload Identity (Cloud Run / GKE) or a service account key.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ─── Pub/Sub emulator (dev) ───────────────────────────────────────────────────
# Honored automatically by the @google-cloud/pubsub SDK — no code changes needed.
# Leave unset in production (SDK uses ADC to reach real GCP Pub/Sub).
PUBSUB_EMULATOR_HOST=localhost:8085

# ─── KMS ──────────────────────────────────────────────────────────────────────
# Dev: generate a random 32-byte base64 key to bypass Cloud KMS:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Production: leave unset — per-tenant KMS key names are stored in the DB.
KMS_DEV_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# ─── Secret Manager (dev) ─────────────────────────────────────────────────────
# JSON map of Secret Manager resource names → plaintext values.
# Lets harness containers call getSecret() without real GCP credentials.
# Example: SM_DEV_SECRETS='{"projects/local/secrets/my-secret/versions/latest":"value"}'
SM_DEV_SECRETS=

# ─── Cloud Run (worker) ───────────────────────────────────────────────────────
# Dev: skip OIDC auth when invoking locally-running harness containers.
# Production: leave unset (worker fetches OIDC tokens via ADC automatically).
CLOUD_RUN_SKIP_AUTH=true

# ─── Webhook gateway ──────────────────────────────────────────────────────────
# Public URL used when constructing Shopify webhook callback URLs.
# Dev: use ngrok — `ngrok http 3001` — then paste the https URL here.
WEBHOOK_BASE_URL=https://webhooks.yourdomain.com

# ─── Platform API (public URL) ────────────────────────────────────────────────
# Public URL of the API service (port 3002).
# Used by: OAuth callback redirect URI, platform_app.base_url shop metafield.
# Dev: use ngrok — `ngrok http 3002` — then paste the https URL here.
PLATFORM_URL=https://api.yourdomain.com

# ─── Shopify OAuth (One Umbrella App) ────────────────────────────────────────
# client_id and client_secret from the Shopify Partner Dashboard.
# Must match the values in shopify-app/shopify.app.toml.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# UID field from shopify-app/extensions/widget-runtime/shopify.extension.toml
SHOPIFY_WIDGET_EXTENSION_UID=
# GCP Secret Manager resource name for the Shopify webhook HMAC signing secret.
# Dev placeholder: SM_DEV_SECRETS must map this name to the actual secret value.
# Production: projects/{project}/secrets/shopify-webhook-secret/versions/latest
SHOPIFY_SECRET_NAME=projects/local/secrets/shopify-webhook-secret/versions/latest

# ─── Shopify Partners API ─────────────────────────────────────────────────────
# Used only by the Shopify CLI / Partners API (not at runtime).
# From partners.shopify.com → Settings → Partner API clients → Create API key
SHOPIFY_PARTNERS_TOKEN=prtapi_...
SHOPIFY_PARTNER_ORG_ID=              # numeric org ID from partner dashboard URL

# ─── Shopify Billing ─────────────────────────────────────────────────────────
# disabled — bypass Shopify entirely (custom apps, local dev)
# test     — call Shopify with test:true, no real charges (public app staging)
# live     — call Shopify with real charges (production)
SHOPIFY_BILLING_MODE=disabled

# ─── Dashboard ────────────────────────────────────────────────────────────────
# URL of the merchant dashboard. OAuth redirects here after install.
# Dev: http://localhost:3000
DASHBOARD_URL=http://localhost:3000

# ─── Worker ───────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=10

# ─── Deployer ─────────────────────────────────────────────────────────────────
# "local"    — docker run on the compose network (dev default)
# "cloudrun" — deploy to GCP Cloud Run (production)
DEPLOY_MODE=local

# Skip docker push in local mode (image stays local, no registry needed).
SKIP_DOCKER_PUSH=true

# Docker Compose network that harness containers join (docker compose derives
# this from the directory name: <dirname>_default).
COMPOSE_NETWORK=new-one-two_default

# ─── PORT / SERVICE_NAME ──────────────────────────────────────────────────────
# Do NOT set PORT or SERVICE_NAME here — each service has its own default
# (api: 3002, webhook-gateway: 3001) and they conflict when sharing one .env.
# Override per-process in .vscode/launch.json or your shell.

# ─── API Authentication ───────────────────────────────────────────────────────
# JWT signing key for platform auth tokens. Falls back to SHOPIFY_CLIENT_SECRET
# if not set. Recommended: set a dedicated secret in production.
# JWT_SECRET=
# Set to "true" in production to enforce Bearer token auth on API routes.
# Dev default: false (allows unauthenticated requests for local development).
API_AUTH_REQUIRED=false

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the API.
# Only enforced in production (NODE_ENV=production). In dev, all origins are allowed.
# Example: ALLOWED_ORIGINS=https://dashboard.yourdomain.com,https://admin.shopify.com
# ALLOWED_ORIGINS=

# ─── GCS Widget Serving ──────────────────────────────────────────────────────
# Bucket for widget JS and admin UI bundles. In production, the API redirects
# widget requests to GCS instead of reading from Postgres.
GCS_BUNDLES_BUCKET=new-one-two-bundles-dev

# ─── Production overrides ─────────────────────────────────────────────────────
# GCP_PROJECT=your-gcp-project-id    # overrides GOOGLE_CLOUD_PROJECT in deployer
# GCP_REGION=us-central1
# DOCKER_REGISTRY=gcr.io/your-gcp-project-id
