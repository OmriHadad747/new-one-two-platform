{
  "name": "@platform-back/api",
  "version": "0.1.0",
  "private": true,
  "description": "Platform edge — verifies Shopify trust-domain auth and forwards to per-tenant handler containers",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@platform-back/db": "workspace:*",
    "@platform-back/logger": "workspace:*",
    "fastify": "^4.28.0",
    "google-auth-library": "^9.14.0"
  }
}
