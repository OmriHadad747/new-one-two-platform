{
  "name": "@platform-back/api",
  "version": "0.1.0",
  "private": true,
  "description": "Platform edge — verifies Shopify trust-domain auth and forwards to per-tenant handler containers",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@google-cloud/pubsub": "^4.7.0",
    "@google-cloud/storage": "^7.19.0",
    "@platform-back/crypto": "workspace:*",
    "@platform-back/db": "workspace:*",
    "@platform-back/deployer": "workspace:*",
    "@platform-back/email": "workspace:*",
    "@platform-back/files": "workspace:*",
    "@platform-back/logger": "workspace:*",
    "@platform-back/types": "workspace:*",
    "fastify": "^4.28.0",
    "fastify-raw-body": "^4.3.0",
    "google-auth-library": "^9.14.0",
    "jose": "^5.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "vitest": "^2.1.0"
  }
}
