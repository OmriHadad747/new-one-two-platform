    "@platform-back/types": "workspace:*",
    "bullmq": "^5.10.0",
    "fastify": "^4.28.0",
    "fastify-plugin": "^4.5.1",
    "ioredis": "^5.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
