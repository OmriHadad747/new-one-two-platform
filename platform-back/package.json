{
  "name": "platform-back",
  "private": true,
  "scripts": {
    "build": "tsc -b apps/api packages/email packages/deployer",
    "typecheck": "tsc -b apps/api packages/email packages/deployer",
    "clean": "tsc -b apps/api packages/email packages/deployer --clean",
    "dev": "pnpm --filter @platform-back/api dev",
    "test": "vitest run --workspace vitest.workspace.ts",
    "test:watch": "vitest --workspace vitest.workspace.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "prettier": "^3.8.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.9"
}
