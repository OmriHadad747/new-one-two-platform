{
  "name": "handler-template",
  "version": "0.1.0",
  "private": true,
  "description": "Reference handler — the shape every generated tenant container takes. Hand-written; the generator emits variations of this.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "node dist/migrate.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@shopify/shopify-api": "^11.6.0",
    "@xmldom/xmldom": "^0.8.10",
    "csv-parse": "^5.5.6",
    "csv-stringify": "^6.5.2",
    "dayjs": "^1.11.13",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "fast-xml-parser": "^4.3.6",
    "google-auth-library": "^9.14.0",
    "handlebars": "^4.7.8",
    "jose": "^5.9.0",
    "jsbarcode": "^3.11.6",
    "jszip": "^3.10.1",
    "marked": "^15.0.0",
    "pdfkit": "^0.15.0",
    "postgres": "^3.4.4",
    "qrcode": "^1.5.3",
    "sharp": "^0.33.5",
    "slugify": "^1.6.6",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
