{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "progress-event",
  "title": "ProgressEvent",
  "description": "Published to generation.progress topic by the Python generator as each agent starts and completes.",
  "type": "object",
  "required": ["jobId", "agent", "status", "message", "timestampMs"],
  "additionalProperties": false,
  "properties": {
    "jobId": {
      "type": "string",
      "format": "uuid"
    },
    "agent": {
      "type": "string",
      "enum": ["intent", "schema", "codegen", "appblock", "handler", "migration", "validation", "explanation"],
      "description": "Which agent emitted this event."
    },
    "status": {
      "type": "string",
      "enum": ["running", "completed", "failed", "retrying"]
    },
    "message": {
      "type": "string",
      "description": "Human-readable status message shown on the merchant's progress screen."
    },
    "timestampMs": {
      "type": "integer",
      "description": "Unix epoch milliseconds."
    },
    "attempt": {
      "type": "integer",
      "description": "Retry attempt number (1-indexed). Only present when status is retrying.",
      "minimum": 1
    }
  }
}
