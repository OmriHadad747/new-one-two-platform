{
  "prompt": "Automatically email customers when a previously out-of-stock product is back in inventory.",
  "intent": {
    "triggerTypes": [
      "cron",
      "product_update"
    ],
    "resources": [
      "Product",
      "Inventory"
    ],
    "desiredOutcome": "Automatically email customers when a previously out-of-stock product is back in inventory.",
    "cronSchedule": "0 * * * *",
    "appCategory": "storefront_backend_admin"
  },
  "plan": {
    "shopifyPlan": {
      "webhookTopics": [
        "inventory_levels/update"
      ],
      "cronSchedule": "0 * * * *"
    },
    "appContracts": {
      "feasibility": "feasible",
      "blockedReason": null,
      "complexity": "high",
      "stateMachine": {
        "entity": "inventory_level",
        "trackedField": "available",
        "unknownSentinel": "null",
        "skipWhenUnknown": true,
        "transitions": [
          {
            "from": "zero_or_negative",
            "to": "positive",
            "action": "notify_subscribers"
          }
        ]
      },
      "platformGaps": [
        {
          "gap": "No real-time push confirmation back to the storefront widget after the subscription is recorded",
          "mitigation": "The widget optimistically shows a confirmation message immediately on form submit (POST /subscribe returns {subscribed: true}); actual email delivery is asynchronous via the email capability and requires no further widget update."
        }
      ],
      "cronBatching": {
        "required": true,
        "description": "Each hourly run queries all pending subscriptions grouped by inventory_item_id, then bulk-fetches current inventory levels from Shopify in a single Admin API call before looping to compare against last_known_available and trigger emails."
      },
      "dbContracts": [
        {
          "table": "back_in_stock_subscriptions",
          "columns": [
            {
              "name": "id",
              "type": "UUID",
              "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"
            },
            {
              "name": "tenant_id",
              "type": "UUID",
              "constraints": "NOT NULL"
            },
            {
              "name": "customer_id",
              "type": "BIGINT",
              "constraints": "NULL"
            },
            {
              "name": "email",
              "type": "TEXT",
              "constraints": "NOT NULL"
            },
            {
              "name": "product_id",
              "type": "BIGINT",
              "constraints": "NOT NULL"
            },
            {
              "name": "variant_id",
              "type": "BIGINT",
              "constraints": "NOT NULL"
            },
            {
              "name": "inventory_item_id",
              "type": "BIGINT",
              "constraints": "NOT NULL"
            },
            {
              "name": "notified_at",
              "type": "TIMESTAMPTZ",
              "constraints": "NULL"
            },
            {
              "name": "created_at",
              "type": "TIMESTAMPTZ",
              "constraints": "NOT NULL DEFAULT now()"
            }
          ],
          "uniqueConstraint": [
            "tenant_id",
            "email",
            "variant_id"
          ],
          "indexes": [
            "tenant_id",
            "inventory_item_id",
            "notified_at"
          ],
          "rls": true
        },
        {
          "table": "inventory_level_states",
          "columns": [
            {
              "name": "id",
              "type": "UUID",
              "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"
            },
            {
              "name": "tenant_id",
              "type": "UUID",
              "constraints": "NOT NULL"
            },
            {
              "name": "inventory_item_id",
              "type": "BIGINT",
              "constraints": "NOT NULL"
            },
            {
              "name": "location_id",
              "type": "BIGINT",
              "constraints": "NOT NULL"
            },
            {
              "name": "last_known_available",
              "type": "INTEGER",
              "constraints": "NULL"
            },
            {
              "name": "updated_at",
              "type": "TIMESTAMPTZ",
              "constraints": "NOT NULL DEFAULT now()"
            }
          ],
          "uniqueConstraint": [
            "tenant_id",
            "inventory_item_id",
            "location_id"
          ],
          "indexes": [
            "tenant_id",
            "inventory_item_id"
          ],
          "rls": true
        }
      ],
      "webhookContract": {
        "payloadFields": [
          "inventory_item_id",
          "location_id",
          "available"
        ],
        "handlerMustProduce": "Using inventory_item_id and location_id from the payload, look up the prior last_known_available from inventory_level_states. If the prior value was zero or negative (or null \u2014 skip when unknown) and the incoming available is positive, resolve all unnotified back_in_stock_subscriptions matching this tenant and inventory_item_id, then send notification emails and mark notified_at. Always upsert inventory_level_states with the new available value from the payload."
      },
      "cronContract": {
        "handlerMustProduce": "For each distinct inventory_item_id with unnotified subscriptions (notified_at IS NULL), bulk-fetch current inventory levels from Shopify Admin API. For each item where the returned available quantity is positive and last_known_available in inventory_level_states was zero or negative (or null), send notification emails to all matching subscribers and set notified_at. Update inventory_level_states.last_known_available for every fetched item."
      },
      "widgetTargetTemplates": [
        "product"
      ],
      "widgetApiCatalog": [
        {
          "path": "/subscribe",
          "method": "POST",
          "requestShape": {
            "email": "string",
            "product_id": "number",
            "variant_id": "number"
          },
          "responseShape": {
            "subscribed": "boolean",
            "message": "string"
          }
        },
        {
          "path": "/subscription-status",
          "method": "GET",
          "requestShape": {
            "email": "string",
            "variant_id": "number"
          },
          "responseShape": {
            "subscribed": "boolean"
          }
        }
      ],
      "adminApiCatalog": [
        {
          "path": "/subscriptions",
          "method": "GET",
          "requestShape": {},
          "responseShape": {
            "subscriptions": [
              {
                "id": "string",
                "email": "string",
                "customer_id": "number | null",
                "product_id": "number",
                "variant_id": "number",
                "notified_at": "string | null",
                "created_at": "string"
              }
            ],
            "total": "number"
          }
        },
        {
          "path": "/subscriptions/:id",
          "method": "POST",
          "requestShape": {
            "action": "string"
          },
          "responseShape": {
            "success": "boolean"
          }
        },
        {
          "path": "/inventory-states",
          "method": "GET",
          "requestShape": {},
          "responseShape": {
            "states": [
              {
                "inventory_item_id": "number",
                "location_id": "number",
                "last_known_available": "number | null",
                "updated_at": "string"
              }
            ]
          }
        },
        {
          "path": "/run",
          "method": "POST",
          "requestShape": {},
          "responseShape": {
            "triggered": "boolean",
            "emails_sent": "number",
            "items_checked": "number"
          }
        }
      ]
    }
  },
  "validation_errors": []
}